# Preview-pages.sh stages CI-equivalent artifacts here before invoking the
# dashboard build script. Regenerated on every run; never committed.
_artifacts/

# JUnit XML emitted by the test runners. Picked up by CI as artifacts and
# fed to the dashboard build, but always regenerated locally — never tracked.
**/report.xml
**/results.xml
**/junit.xml

