# Copy this file to .env and fill in real values for local runs.
# Never commit a real .env file; it is already in .gitignore.

# Required to actually call Anthropic. Leave unset to skip live evals locally.
ANTHROPIC_API_KEY=

# Optional: enable LangSmith tracing for every generator + judge call.
# Sign up at https://smith.langchain.com for a free API key.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=qa-automation-lab-llm-evals
